generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id_role    Int       @id @default(autoincrement())
  role_name  RoleName  @unique(map: "role_name")
  created_at DateTime? @default(now()) @db.Timestamp(0)
  users      User[]

  @@map("roles")
}

model MedicalCenter {
  id_medical_center   Int               @id @default(autoincrement())
  name                String            @db.VarChar(150)
  type                String            @db.VarChar(60)
  address             String            @db.VarChar(255)
  phone               String            @db.VarChar(50)
  created_at          DateTime?         @default(now()) @db.Timestamp(0)
  updated_at          DateTime?         @default(now()) @updatedAt @db.Timestamp(0)
  blood_units         BloodUnit[]
  requested_transfers TransferRequest[] @relation("RequestingCenter")
  supplied_transfers  TransferRequest[] @relation("SupplyingCenter")
  users               User[]

  @@map("medical_centers")
}

model User {
  id_user           Int               @id @default(autoincrement())
  full_name         String            @db.VarChar(120)
  email             String            @unique(map: "email") @db.VarChar(120)
  password_hash     String            @db.VarChar(255)
  id_role           Int
  id_medical_center Int?
  created_at        DateTime?         @default(now()) @db.Timestamp(0)
  updated_at        DateTime?         @default(now()) @updatedAt @db.Timestamp(0)
  movements         MovementHistory[]
  medical_center    MedicalCenter?    @relation(fields: [id_medical_center], references: [id_medical_center], map: "fk_users_medical_center")
  role              Role              @relation(fields: [id_role], references: [id_role], map: "fk_users_role")

  @@index([id_medical_center], map: "fk_users_medical_center")
  @@index([id_role], map: "fk_users_role")
  @@map("users")
}

model BloodUnit {
  id_blood_unit     Int               @id @default(autoincrement())
  blood_type        BloodType
  rh_factor         RhFactor
  extraction_date   DateTime          @db.DateTime(0)
  expiration_date   DateTime          @db.DateTime(0)
  status            BloodUnitStatus   @default(AVAILABLE)
  id_medical_center Int
  created_at        DateTime?         @default(now()) @db.Timestamp(0)
  updated_at        DateTime?         @default(now()) @updatedAt @db.Timestamp(0)
  medical_center    MedicalCenter     @relation(fields: [id_medical_center], references: [id_medical_center], map: "fk_blood_units_center")
  movement_history  MovementHistory[]
  transfer_details  TransferDetail[]

  @@index([id_medical_center], map: "fk_blood_units_center")
  @@index([expiration_date], map: "idx_blood_units_expiration")
  @@index([status], map: "idx_blood_units_status")
  @@index([blood_type, rh_factor], map: "idx_blood_units_type_rh")
  @@map("blood_units")
}

model TransferRequest {
  id_transfer_request  Int                   @id @default(autoincrement())
  id_requesting_center Int
  id_supplying_center  Int
  blood_type           BloodType
  quantity             Int
  status               TransferRequestStatus @default(PENDING)
  request_date         DateTime?             @default(now()) @db.Timestamp(0)
  created_at           DateTime?             @default(now()) @db.Timestamp(0)
  updated_at           DateTime?             @default(now()) @updatedAt @db.Timestamp(0)
  transfer_details     TransferDetail[]
  requesting_center    MedicalCenter         @relation("RequestingCenter", fields: [id_requesting_center], references: [id_medical_center], map: "fk_transfer_requesting_center")
  supplying_center     MedicalCenter         @relation("SupplyingCenter", fields: [id_supplying_center], references: [id_medical_center], map: "fk_transfer_supplying_center")

  @@index([id_requesting_center], map: "fk_transfer_requesting_center")
  @@index([id_supplying_center], map: "fk_transfer_supplying_center")
  @@index([status], map: "idx_transfer_requests_status")
  @@map("transfer_requests")
}

model TransferDetail {
  id_transfer_detail  Int             @id @default(autoincrement())
  id_transfer_request Int
  id_blood_unit       Int
  transfer_request    TransferRequest @relation(fields: [id_transfer_request], references: [id_transfer_request], onDelete: Cascade, map: "fk_transfer_details_request")
  blood_unit          BloodUnit       @relation(fields: [id_blood_unit], references: [id_blood_unit], map: "fk_transfer_details_unit")

  @@index([id_transfer_request], map: "fk_transfer_details_request")
  @@index([id_blood_unit], map: "fk_transfer_details_unit")
  @@map("transfer_details")
}

model MovementHistory {
  id_movement_history Int       @id @default(autoincrement())
  id_blood_unit       Int
  id_user             Int
  action              String    @db.VarChar(255)
  timestamp           DateTime? @default(now()) @db.Timestamp(0)
  blood_unit          BloodUnit @relation(fields: [id_blood_unit], references: [id_blood_unit], map: "fk_movements_blood_unit")
  user                User      @relation(fields: [id_user], references: [id_user], map: "fk_movements_user")

  @@index([id_user], map: "fk_movements_user")
  @@index([id_blood_unit], map: "idx_movement_histories_unit")
  @@map("movement_histories")
}

enum RoleName {
  ADMIN_GENERAL
  BANK_MANAGER
}

enum BloodType {
  A
  B
  AB
  O
}

enum RhFactor {
  POSITIVE
  NEGATIVE
}

enum BloodUnitStatus {
  AVAILABLE
  NEAR_EXPIRATION
  EXPIRED
  DISCARDED
  TRANSFERRED
}

enum TransferRequestStatus {
  PENDING
  APPROVED
  REJECTED
  IN_TRANSIT
  COMPLETED
}
